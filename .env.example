# ── Environment ──
ENV=development

# ── Database ──
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret_2024
POSTGRES_DB=sentinelclear
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret_2024@postgres-db:5432/sentinelclear
DATABASE_READ_URL=postgresql+asyncpg://sentinel:sentinel_secret_2024@postgres-db:5432/sentinelclear

# ── RabbitMQ ──
RABBITMQ_DEFAULT_USER=sentinel
RABBITMQ_DEFAULT_PASS=sentinel_rabbit_2024
RABBITMQ_URL=amqp://sentinel:sentinel_rabbit_2024@rabbitmq:5672/

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Neo4j ──
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASS=sentinel_neo4j_2024

# ── JWT ──
JWT_SECRET_KEY=replace_with_long_random_secure_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Admin ──
ADMIN_SECRET_KEY=replace_with_a_long_secure_admin_secret_key
ADMIN_PASSWORD=admin

# ── Fraud Detection ──
FRAUD_AMOUNT_THRESHOLD=50000
FRAUD_VELOCITY_MAX=5
FRAUD_VELOCITY_WINDOW=600
FRAUD_DAILY_VOLUME_LIMIT=200000
FRAUD_NEW_ACCOUNT_HOURS=24
FRAUD_NEW_ACCOUNT_AMOUNT=10000
FRAUD_REVIEW_THRESHOLD=0.4
FRAUD_BLOCK_THRESHOLD=0.7

# ── Maker Checker ──
MAKER_CHECKER_THRESHOLD=500000

# ── Chaos Engineering ──
ENABLE_CHAOS_ENDPOINTS=false

# ── Reconciliation ──
RECONCILIATION_INTERVAL_HOURS=24

# ── Grafana ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password
