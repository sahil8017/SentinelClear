# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=sentinel_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres-db:5432/${POSTGRES_DB}
DATABASE_READ_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres-db:5432/${POSTGRES_DB}

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=YOUR_STRONG_RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/

# Redis
REDIS_URL=redis://redis:6379/0

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASS=YOUR_STRONG_NEO4J_PASSWORD
NEO4J_URI=bolt://neo4j:7687

# App Security
SECRET_KEY=GENERATE_A_SECURE_RANDOM_SECRET_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD
ADMIN_EMAIL=admin@yourdomain.com

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=YOUR_STRONG_GRAFANA_PASSWORD

# Domain
DOMAIN_NAME=yourdomain.com
